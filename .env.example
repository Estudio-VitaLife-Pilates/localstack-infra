# Copie este arquivo para ".env" (mesma pasta) e cole seu token de:
# https://app.localstack.cloud/workspace/auth-tokens
#
# Cada pessoa do time usa o SEU PRÓPRIO token (é grátis, não precisa cartão).
# O arquivo ".env" não vai pro Git — cada um configura o seu localmente.

LOCALSTACK_AUTH_TOKEN=cole_seu_token_aqui
